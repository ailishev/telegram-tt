generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ChatType {
  PRIVATE
  GROUP
}

enum MessageType {
  TEXT
  MEDIA
}

model User {
  id           String            @id @default(uuid()) @db.Uuid
  username     String            @unique @db.VarChar(32)
  phone        String?           @unique @db.VarChar(32)
  email        String?           @unique @db.VarChar(255)
  passwordHash String            @map("password_hash")
  avatar       String?           @db.VarChar(2048)
  bio          String?           @db.VarChar(500)
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  profile      Profile?
  chats        ChatParticipant[]
  sentMessages Message[]
  sessions     Session[]

  @@index([createdAt])
  @@map("users")
}

model Profile {
  userId      String   @id @map("user_id") @db.Uuid
  displayName String?  @map("display_name") @db.VarChar(80)
  timezone    String?  @db.VarChar(64)
  locale      String?  @db.VarChar(16)
  lastSeenAt  DateTime? @map("last_seen_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Chat {
  id          String            @id @default(uuid()) @db.Uuid
  type        ChatType
  title       String?           @db.VarChar(120)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  participants ChatParticipant[]
  messages     Message[]

  @@index([type, createdAt])
  @@map("chats")
}

model ChatParticipant {
  chatId      String   @map("chat_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  role        String   @default("member") @db.VarChar(20)
  joinedAt    DateTime @default(now()) @map("joined_at")

  chat        Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([chatId, userId])
  @@index([userId, joinedAt])
  @@map("chat_participants")
}

model Message {
  id          String      @id @default(uuid()) @db.Uuid
  chatId      String      @map("chat_id") @db.Uuid
  senderId    String      @map("sender_id") @db.Uuid
  content     String?     @db.Text
  type        MessageType @default(TEXT)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  chat        Chat        @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender      User        @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([chatId, createdAt])
  @@index([senderId, createdAt])
  @@map("messages")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  refreshToken String   @unique @map("refresh_token") @db.VarChar(255)
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}
