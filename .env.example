APP_ENV=development
APP_TITLE=Telegram Web
APP_NAME=Telegram Web A
APP_MOCKED_CLIENT=1

# Primary backend contract (optional proxy/api adapter)
APP_API_BASE_URL=http://localhost:3000

# Supabase client-side config
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only variable (never expose in browser bundles)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Development auth behavior
APP_DEMO_AUTH_PASSWORD=change_me_for_dev
APP_DEV_ACCEPT_ANY_CODE=1
